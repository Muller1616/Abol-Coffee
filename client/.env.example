# Leave empty in local development to use the Vite proxy (recommended for cookie auth).
# In production, set this to the public API origin (no trailing slash), e.g.:
# VITE_API_URL=https://api.yourdomain.com
#
# Required when the SPA and API are on different origins so:
# - Axios calls hit the API
# - Legacy /uploads/... media URLs resolve to the API host
# - QR download links work
#
# Cloudinary image URLs are absolute HTTPS and do not need VITE_API_URL.
VITE_API_URL=
