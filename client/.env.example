# Leave EMPTY for Vercel production when using /api proxy rewrites (recommended).
# The browser calls same-origin /api/... and Vercel forwards to Render.
# That keeps login cookies + CSRF working.
#
# Only set this if the SPA talks to the API on a different origin WITHOUT a proxy:
# VITE_API_URL=https://abol-coffee.onrender.com
VITE_API_URL=
