{
  "name": "abol-coffee-server",
  "version": "1.0.0",
  "private": true,
  "description": "Restaurant QR Digital Menu API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node -e \"if(process.env.NODE_ENV==='production'){console.error('Use npm run start:prod in production (runs migrations).');process.exit(1)}\" && node dist/index.js",
    "start:prod": "prisma migrate deploy && node dist/index.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "db:setup": "prisma migrate dev && prisma db seed",
    "verify:auth": "tsx scripts/verify-auth.ts",
    "verify:restaurant": "tsx scripts/verify-restaurant.ts",
    "verify:categories": "tsx scripts/verify-categories.ts",
    "verify:menu-items": "tsx scripts/verify-menu-items.ts",
    "verify:uploads": "tsx scripts/verify-uploads.ts",
    "verify:public-menu": "tsx scripts/verify-public-menu.ts",
    "verify:dashboard": "tsx scripts/verify-dashboard.ts",
    "verify:qr": "tsx scripts/verify-qr.ts",
    "verify:all": "tsx scripts/verify-all.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "prisma": "^7.9.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
