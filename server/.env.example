NODE_ENV=development
PORT=4001
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://abol:abol_dev_password@127.0.0.1:5434/abol_coffee?schema=public
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=ChangeMe123!
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
# Permanent public menu URL encoded into printed QR codes. Must be HTTPS in production.
PUBLIC_MENU_URL=http://localhost:5173/menu

# Cookie auth across separate frontend/API domains (e.g. app.example.com → api.example.com):
# COOKIE_SAME_SITE=none
# COOKIE_DOMAIN=.example.com

# Optional local-disk fallback (development only when Cloudinary is unset)
# UPLOADS_DIR=/var/data/uploads

# LOG_LEVEL=info

# Required in production for password-reset OTP emails.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Abol Coffee <noreply@yourdomain.com>"

# Required in production — all restaurant/menu images are stored on Cloudinary.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
