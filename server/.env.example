# COOKIE_SAME_SITE=none
# COOKIE_DOMAIN=.example.com

# Persistent upload directory (mount a volume here in production)
# UPLOADS_DIR=/var/data/uploads

# LOG_LEVEL=info

# Required in production for password-reset OTP emails.
# Without SMTP in development, codes are written to structured logs (never in production).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Abol Coffee <noreply@yourdomain.com>"
