generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RestaurantStatus {
  ACTIVE
  MAINTENANCE
}

enum AdminAction {
  CREATE
  UPDATE
  DELETE
  TOGGLE
  LOGIN
  LOGOUT
  DOWNLOAD
}

enum AdminEntity {
  CATEGORY
  MENU_ITEM
  RESTAURANT
  OWNER
  QR
  SYSTEM
}

model Owner {
  id                String                 @id @default(cuid())
  email             String                 @unique
  password          String
  /** Bumped on password change/reset to invalidate existing JWTs. */
  tokenVersion      Int                    @default(0)
  passwordChangedAt DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  passwordResetOtps PasswordResetOtp[]
  resetSessions     PasswordResetSession[]

  @@map("owners")
}

/** Hashed one-time password reset codes (never store plaintext OTP). */
model PasswordResetOtp {
  id           String    @id @default(cuid())
  ownerId      String
  email        String
  otpHash      String
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  used         Boolean   @default(false)
  usedAt       DateTime?
  invalidated  Boolean   @default(false)
  attemptCount Int       @default(0)
  lastSentAt   DateTime  @default(now())
  owner        Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([email, createdAt])
  @@index([ownerId])
  @@index([expiresAt])
  @@map("password_reset_otps")
}

/** Short-lived session after OTP verification, authorizing password reset. */
model PasswordResetSession {
  id        String    @id @default(cuid())
  ownerId   String
  tokenHash String    @unique
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  owner     Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([expiresAt])
  @@map("password_reset_sessions")
}

model Restaurant {
  id           String           @id @default(cuid())
  name         String
  logo         String?
  coverImage   String?
  address      String?
  phone        String?
  email        String?
  openingHours Json
  description  String?
  facebook     String?
  instagram    String?
  telegram     String?
  status       RestaurantStatus @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([updatedAt])
  @@map("restaurants")
}

model Category {
  id           String     @id @default(cuid())
  name         String     @unique
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  menuItems    MenuItem[]

  @@index([displayOrder])
  @@index([isActive])
  @@index([isActive, displayOrder])
  @@index([updatedAt])
  @@map("categories")
}

model MenuItem {
  id           String   @id @default(cuid())
  categoryId   String
  name         String
  description  String   @default("")
  price        Decimal  @db.Decimal(10, 2)
  currency     String   @default("ETB")
  image        String?
  isAvailable  Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([isAvailable])
  @@index([displayOrder])
  @@index([categoryId, isAvailable, displayOrder])
  @@index([updatedAt])
  @@map("menu_items")
}

model AdminActivity {
  id        String      @id @default(cuid())
  action    AdminAction
  entity    AdminEntity
  /** Fine-grained activity key for UI icons/filters (e.g. MENU_ITEM_PRICE_UPDATED). */
  type      String      @default("SYSTEM")
  /** Short feed headline (e.g. "Price updated"). */
  title     String      @default("Activity")
  entityId  String?
  summary   String
  createdAt DateTime    @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([entity])
  @@index([type])
  @@map("admin_activities")
}
